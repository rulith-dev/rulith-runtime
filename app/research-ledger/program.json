{
  "id": "research_ledger_2",
  "title": "Research ledger",
  "summary": "Keeps an investigation on the Board: hypotheses with their goal, the data they rest on, dropped directions, and which hypotheses are still open. Each top-level goal shows its ledger as research.ledger.item and research.ledger.goal_datum rows.",
  "vocabulary": {
    "defines": [
      {
        "id": "research.ledger.hypothesis",
        "as": "hypothesis",
        "args": [
          "id",
          "claim",
          "goal"
        ]
      },
      {
        "id": "research.ledger.datum",
        "as": "datum",
        "args": [
          "name",
          "value",
          "unit",
          "source",
          "goal"
        ]
      },
      {
        "id": "research.ledger.supported",
        "as": "supported",
        "args": [
          "hypothesis"
        ]
      },
      {
        "id": "research.ledger.refuted",
        "as": "refuted",
        "args": [
          "hypothesis"
        ]
      },
      {
        "id": "research.ledger.dropped",
        "as": "dropped",
        "args": [
          "hypothesis",
          "reason"
        ]
      },
      {
        "id": "research.ledger.is_dropped",
        "as": "is_dropped",
        "args": [
          "hypothesis"
        ]
      },
      {
        "id": "research.ledger.item",
        "as": "item",
        "args": [
          "goal",
          "hypothesis",
          "claim",
          "state"
        ]
      },
      {
        "id": "research.ledger.goal_datum",
        "as": "goal_datum",
        "args": [
          "goal",
          "name",
          "value",
          "unit",
          "source"
        ]
      },
      {
        "id": "research.ledger.goal_open",
        "as": "goal_open",
        "args": [
          "goal"
        ]
      },
      {
        "id": "research.ledger.cites",
        "as": "cites",
        "args": [
          "goal",
          "from_goal"
        ]
      }
    ],
    "imports": [
      {
        "id": "root",
        "as": "root"
      },
      {
        "id": "case_context",
        "as": "case_context"
      }
    ]
  },
  "pins": [
    "is_dropped",
    "item",
    "goal_datum",
    "goal_open"
  ],
  "rules": [
    {
      "id": "ledger_dropped_with_reason",
      "label": "A hypothesis dropped with a reason is dropped.",
      "when": [
        {
          "predicate": "dropped",
          "args": {
            "hypothesis": "?h",
            "reason": "?x"
          }
        }
      ],
      "then": [
        {
          "predicate": "is_dropped",
          "args": {
            "hypothesis": "?h"
          }
        }
      ]
    },
    {
      "id": "ledger_item_open",
      "label": "A hypothesis stays open until it is supported, refuted or dropped.",
      "when": [
        {
          "predicate": "root",
          "args": {
            "node": "?g"
          }
        },
        {
          "predicate": "case_context",
          "args": {
            "root": "?g",
            "case_type": "?t",
            "case_id": "?k"
          }
        },
        {
          "predicate": "hypothesis",
          "args": {
            "id": "?h",
            "claim": "?c",
            "goal": "?g"
          }
        },
        {
          "predicate": "supported",
          "args": {
            "hypothesis": "?h"
          },
          "naf": true
        },
        {
          "predicate": "refuted",
          "args": {
            "hypothesis": "?h"
          },
          "naf": true
        },
        {
          "predicate": "is_dropped",
          "args": {
            "hypothesis": "?h"
          },
          "naf": true
        }
      ],
      "then": [
        {
          "predicate": "item",
          "args": {
            "goal": "?g",
            "hypothesis": "?h",
            "claim": "?c",
            "state": "open"
          }
        }
      ]
    },
    {
      "id": "ledger_item_supported",
      "label": "A hypothesis a rule derives as supported is shown as supported.",
      "when": [
        {
          "predicate": "root",
          "args": {
            "node": "?g"
          }
        },
        {
          "predicate": "case_context",
          "args": {
            "root": "?g",
            "case_type": "?t",
            "case_id": "?k"
          }
        },
        {
          "predicate": "hypothesis",
          "args": {
            "id": "?h",
            "claim": "?c",
            "goal": "?g"
          }
        },
        {
          "predicate": "supported",
          "args": {
            "hypothesis": "?h"
          }
        }
      ],
      "then": [
        {
          "predicate": "item",
          "args": {
            "goal": "?g",
            "hypothesis": "?h",
            "claim": "?c",
            "state": "supported"
          }
        }
      ]
    },
    {
      "id": "ledger_item_refuted",
      "label": "A hypothesis a rule derives as refuted is shown as refuted.",
      "when": [
        {
          "predicate": "root",
          "args": {
            "node": "?g"
          }
        },
        {
          "predicate": "case_context",
          "args": {
            "root": "?g",
            "case_type": "?t",
            "case_id": "?k"
          }
        },
        {
          "predicate": "hypothesis",
          "args": {
            "id": "?h",
            "claim": "?c",
            "goal": "?g"
          }
        },
        {
          "predicate": "refuted",
          "args": {
            "hypothesis": "?h"
          }
        }
      ],
      "then": [
        {
          "predicate": "item",
          "args": {
            "goal": "?g",
            "hypothesis": "?h",
            "claim": "?c",
            "state": "refuted"
          }
        }
      ]
    },
    {
      "id": "ledger_item_dropped",
      "label": "A dropped hypothesis is shown as dropped.",
      "when": [
        {
          "predicate": "root",
          "args": {
            "node": "?g"
          }
        },
        {
          "predicate": "case_context",
          "args": {
            "root": "?g",
            "case_type": "?t",
            "case_id": "?k"
          }
        },
        {
          "predicate": "hypothesis",
          "args": {
            "id": "?h",
            "claim": "?c",
            "goal": "?g"
          }
        },
        {
          "predicate": "is_dropped",
          "args": {
            "hypothesis": "?h"
          }
        }
      ],
      "then": [
        {
          "predicate": "item",
          "args": {
            "goal": "?g",
            "hypothesis": "?h",
            "claim": "?c",
            "state": "dropped"
          }
        }
      ]
    },
    {
      "id": "ledger_goal_with_open_hypothesis",
      "label": "A goal with an open hypothesis still has an open question.",
      "when": [
        {
          "predicate": "item",
          "args": {
            "goal": "?g",
            "hypothesis": "?h",
            "claim": "?c",
            "state": "open"
          }
        }
      ],
      "then": [
        {
          "predicate": "goal_open",
          "args": {
            "goal": "?g"
          }
        }
      ]
    },
    {
      "id": "ledger_goal_data",
      "label": "Each datum recorded for a goal is shown with that goal.",
      "when": [
        {
          "predicate": "root",
          "args": {
            "node": "?g"
          }
        },
        {
          "predicate": "case_context",
          "args": {
            "root": "?g",
            "case_type": "?t",
            "case_id": "?k"
          }
        },
        {
          "predicate": "datum",
          "args": {
            "name": "?n",
            "value": "?v",
            "unit": "?u",
            "source": "?s",
            "goal": "?g"
          }
        }
      ],
      "then": [
        {
          "predicate": "goal_datum",
          "args": {
            "goal": "?g",
            "name": "?n",
            "value": "?v",
            "unit": "?u",
            "source": "?s"
          }
        }
      ]
    },
    {
      "id": "ledger_cited_goal_data",
      "label": "Data of a cited goal is shown with the citing goal.",
      "when": [
        {
          "predicate": "root",
          "args": {
            "node": "?g"
          }
        },
        {
          "predicate": "case_context",
          "args": {
            "root": "?g",
            "case_type": "?t",
            "case_id": "?k"
          }
        },
        {
          "predicate": "cites",
          "args": {
            "goal": "?g",
            "from_goal": "?f"
          }
        },
        {
          "predicate": "datum",
          "args": {
            "name": "?n",
            "value": "?v",
            "unit": "?u",
            "source": "?s",
            "goal": "?f"
          }
        }
      ],
      "then": [
        {
          "predicate": "goal_datum",
          "args": {
            "goal": "?g",
            "name": "?n",
            "value": "?v",
            "unit": "?u",
            "source": "?s"
          }
        }
      ]
    }
  ],
  "acceptance": [],
  "actions": []
}
