              "root": "?g",
              "case_type": "?t",
              "case_id": "?k"
            }
          },
          {
            "predicate": "cites",
            "args": {
              "goal": "?g",
              "from_goal": "?f"
            }
          },
          {
            "predicate": "datum",
            "args": {
              "name": "?n",
              "value": "?v",
              "unit": "?u",
              "source": "?s",
              "goal": "?f"
            }
          }
        ],
        "then": [
          {
            "predicate": "goal_datum",
            "args": {
              "goal": "?g",
              "name": "?n",
              "value": "?v",
              "unit": "?u",
              "source": "?s"
            }
          }
        ]
      }
    ],
    "acceptance": [
      {
        "id": "check_only_bridge",
        "label": "Check-only bridge from the checker contract to its root.",
        "when": [
          {
            "predicate": "acceptance",
            "args": {
              "node": "?node",
              "test": "?g"
            }
          },
          {
            "predicate": "goal_open",
            "args": {
              "goal": "?g"
            }
          }
        ],
        "then": [
          {
            "predicate": "acceptance_met",
            "args": {
              "node": "?node"
            }
          }
        ]
      }
    ],
    "actions": []
  },
