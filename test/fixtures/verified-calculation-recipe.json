{
  "capability": {
    "id": "verified_calculation",
    "version": "1.0.2",
    "title": "Verified Calculation",
    "summary": "Read trusted local JSON, derive an exact total, write the result, and verify it by independent read-back.",
    "caseContracts": [
      {
        "format": "rulith-case-contract/1",
        "caseType": "verified_calculation",
        "title": "Verified calculation",
        "businessKey": {
          "predicate": "rulith.verified_calculation.calculation_input",
          "arguments": [
            "job_id"
          ]
        },
        "opening": {
          "predicate": "rulith.verified_calculation.calculation_input",
          "keyArguments": [
            "job_id"
          ]
        },
        "acceptance": {
          "predicate": "rulith.verified_calculation.calculation_completed",
          "keyArguments": [
            "job_id"
          ],
          "minimumGroundingFloor": "attested"
        },
        "terminal": {
          "cardinality": "once_per_case",
          "disposition": "completed",
          "requiresCertified": true
        }
      }
    ]
  },
  "program": {
    "id": "verified_calculation",
    "title": "Verified Calculation",
    "summary": "Read trusted local JSON, derive an exact total, write the result, and verify it by independent read-back.",
    "vocabulary": {
      "defines": [
        {
          "id": "rulith.verified_calculation.calculation_input",
          "as": "calculation_input",
          "args": [
            "node",
            "job_id",
            "unit_price_cents",
            "quantity",
            "shipping_cents"
          ]
        },
        {
          "id": "rulith.verified_calculation.calculation_result",
          "as": "calculation_result",
          "args": [
            "node",
            "job_id",
            "subtotal_cents",
            "total_cents"
          ]
        },
        {
          "id": "rulith.verified_calculation.output_written",
          "as": "output_written",
          "args": [
            "node",
            "job_id",
            "subtotal_cents",
            "total_cents",
            "status"
          ]
        },
        {
          "id": "rulith.verified_calculation.output_record",
          "as": "output_record",
          "args": [
            "node",
            "job_id",
            "subtotal_cents",
            "total_cents",
            "status"
          ]
        },
        {
          "id": "rulith.verified_calculation.calculation_completed",
          "as": "calculation_completed",
          "args": [
            "job_id"
          ]
        }
      ],
      "imports": [
        {
          "id": "acceptance",
          "as": "acceptance"
        },
        {
          "id": "acceptance_met",
          "as": "acceptance_met"
        }
      ]
    },
    "pins": [
      "calculation_result",
      "calculation_completed"
    ],
    "rules": [
      {
        "id": "calculate_total",
        "label": "subtotal = unit price × quantity; total = subtotal + shipping, using exact-or-fail board arithmetic.",
        "when": [
          {
            "predicate": "calculation_input",
            "args": {
              "node": "?node",
              "job_id": "?job_id",
              "unit_price_cents": "?unit_price_cents",
              "quantity": "?quantity",
              "shipping_cents": "?shipping_cents"
            }
          },
          {
            "predicate": "mul",
            "args": {
              "left": "?unit_price_cents",
              "right": "?quantity",
              "result": "?subtotal_cents"
            }
          },
          {
            "predicate": "add",
            "args": {
              "left": "?subtotal_cents",
              "right": "?shipping_cents",
              "result": "?total_cents"
            }
          }
        ],
        "then": [
          {
            "predicate": "calculation_result",
            "args": {
              "node": "?node",
              "job_id": "?job_id",
              "subtotal_cents": "?subtotal_cents",
              "total_cents": "?total_cents"
            }
          }
        ]
      },
      {
        "id": "complete_verified_calculation",
        "label": "Accept one calculation Case only when the written and independently read-back values match the exact board-derived result.",
        "when": [
          {
            "predicate": "calculation_result",
            "args": {
              "node": "?node",
              "job_id": "?job_id",
              "subtotal_cents": "?subtotal_cents",
              "total_cents": "?total_cents"
            }
          },
          {
            "predicate": "output_written",
            "args": {
              "node": "?node",
              "job_id": "?job_id",
              "subtotal_cents": "?subtotal_cents",
              "total_cents": "?total_cents",
              "status": "completed"
            }
          },
          {
            "predicate": "output_record",
            "args": {
              "node": "?node",
              "job_id": "?job_id",
              "subtotal_cents": "?subtotal_cents",
              "total_cents": "?total_cents",
              "status": "completed"
            }
          }
        ],
        "then": [
          {
            "predicate": "calculation_completed",
            "args": {
              "job_id": "?job_id"
            }
          }
        ]
      }
    ],
    "acceptance": [
      {
        "id": "accept_read_back_output",
        "label": "The leaf is accepted only when the worker read back the same job and exact totals that the board derived.",
        "when": [
          {
            "predicate": "acceptance",
            "args": {
              "node": "?node",
              "test": "?test"
            }
          },
          {
            "predicate": "calculation_completed",
            "args": {
              "job_id": "?test"
            }
          }
        ],
        "then": [
          {
            "predicate": "acceptance_met",
            "args": {
              "node": "?node"
            }
          }
        ]
      }
    ],
    "actions": [
      {
        "action": "load_calculation_input",
        "description": "[intake] Read and validate the configured local input.json. Pass only the bound file Source. After opening the verified_calculation Case for the returned job_id, use ApplyBatch to declare_goal(id=node, desired=rulith.verified_calculation.calculation_completed(job_id)), then declare the task leaf with goal_node(node), subgoal_of(child=node,parent=the Case root), and acceptance(node,test=job_id). Task structure is an Agent proposal; trusted input is supplied only by this Source.",
        "preconditions": [],
        "effects": [],
        "execution": {
          "tool": "rulith.verified_calculation.read_input@1",
          "sourceTypes": [
            "file"
          ],
          "kind": "read",
          "params": {},
          "returns": [
            {
              "predicate": "calculation_input",
              "args": {
                "node": "$node",
                "job_id": "$job_id",
                "unit_price_cents": "$unit_price_cents",
                "quantity": "$quantity",
                "shipping_cents": "$shipping_cents"
              }
            }
          ]
        }
      },
      {
        "action": "write_calculation_result",
        "description": "Pass job_id and the logical file source. The declared bindings obtain the node, source input values and exact subtotal/total from trusted Board premises for this job. Do not pass or override those bound fields. Core revalidates the saved complete parameters before the Worker writes.",
        "preconditions": [
          {
            "predicate": "calculation_input",
            "args": {
              "node": "?node",
              "job_id": "?job_id",
              "unit_price_cents": "?unit_price_cents",
              "quantity": "?quantity",
              "shipping_cents": "?shipping_cents"
            }
          },
          {
            "predicate": "calculation_result",
            "args": {
              "node": "?node",
              "job_id": "?job_id",
              "subtotal_cents": "?subtotal_cents",
              "total_cents": "?total_cents"
            }
          }
        ],
        "effects": [
          {
            "predicate": "output_written",
            "args": {
              "node": "?node",
              "job_id": "?job_id",
              "subtotal_cents": "?subtotal_cents",
              "total_cents": "?total_cents",
              "status": "completed"
            }
          }
        ],
        "execution": {
          "tool": "rulith.verified_calculation.write_output@1",
          "sourceTypes": [
            "file"
          ],
          "kind": "write",
          "params": {
            "node": "string",
            "job_id": "string",
            "unit_price_cents": "number",
            "quantity": "number",
            "shipping_cents": "number",
            "subtotal_cents": "number",
            "total_cents": "number"
          }
        },
        "bindings": {
          "node": "?node",
          "unit_price_cents": "?unit_price_cents",
          "quantity": "?quantity",
          "shipping_cents": "?shipping_cents",
          "subtotal_cents": "?subtotal_cents",
          "total_cents": "?total_cents"
        }
      },
      {
        "action": "verify_calculation_output",
        "description": "Pass job_id and the logical file source. Declared bindings use the same trusted calculation and write receipt to obtain the expected output fields. This independent read-back must confirm the stored file before claiming completion.",
        "preconditions": [
          {
            "predicate": "calculation_result",
            "args": {
              "node": "?node",
              "job_id": "?job_id",
              "subtotal_cents": "?subtotal_cents",
              "total_cents": "?total_cents"
            }
          },
          {
            "predicate": "output_written",
            "args": {
              "node": "?node",
              "job_id": "?job_id",
              "subtotal_cents": "?subtotal_cents",
              "total_cents": "?total_cents",
              "status": "?status"
            }
          }
        ],
        "effects": [],
        "execution": {
          "tool": "rulith.verified_calculation.verify_output@1",
          "sourceTypes": [
            "file"
          ],
          "kind": "read",
          "params": {
            "node": "string",
            "job_id": "string",
            "subtotal_cents": "number",
            "total_cents": "number",
            "status": "string"
          },
          "returns": [
            {
              "predicate": "output_record",
              "args": {
                "node": "$node",
                "job_id": "$job_id",
                "subtotal_cents": "$subtotal_cents",
                "total_cents": "$total_cents",
                "status": "$status"
              }
            }
          ]
        },
        "bindings": {
          "node": "?node",
          "subtotal_cents": "?subtotal_cents",
          "total_cents": "?total_cents",
          "status": "?status"
        }
      }
    ]
  },
