{
  "packs": [
    {
      "packType": "domain",
      "pack": {
        "format": "rulith-pack/1",
        "meta": {
          "name": "verified_calculation",
          "version": 1,
          "deps": [],
          "provides": ["calculation_result"]
        },
        "vocab": [
          {
            "predicate": "calculation_input",
            "args": ["node", "job_id", "unit_price_cents", "quantity", "shipping_cents"],
            "description": "A validated input record read by the trusted local source adapter; the model cannot assert this predicate."
          },
          {
            "predicate": "calculation_result",
            "args": ["node", "job_id", "subtotal_cents", "total_cents"],
            "description": "Exact subtotal and total derived by the board closure, never supplied by the model or source adapter."
          },
          {
            "predicate": "output_written",
            "args": ["node", "job_id", "subtotal_cents", "total_cents", "status"],
            "description": "Synchronous action effect applied only after the trusted writer atomically wrote and read back the output file."
          },
          {
            "predicate": "output_record",
            "args": ["node", "job_id", "subtotal_cents", "total_cents", "status"],
            "description": "Independent read-only verification of the persisted output, attested through the configured worker channel."
          },
          {
            "predicate": "task_seed",
            "args": ["root", "node", "test"],
            "description": "Trusted intake result used by the host to create the one-leaf task tree."
          }
        ],
        "axioms": [
          {
            "id": "calculate_total",
            "description": "subtotal = unit price × quantity; total = subtotal + shipping, using exact-or-fail board arithmetic.",
            "tier": "verified",
            "source": "integer-arithmetic",
            "when": [
              {
                "predicate": "calculation_input",
                "args": {
                  "node": "?node",
                  "job_id": "?job_id",
                  "unit_price_cents": "?unit_price_cents",
                  "quantity": "?quantity",
                  "shipping_cents": "?shipping_cents"
                }
              },
              {
                "predicate": "mul",
                "args": { "left": "?unit_price_cents", "right": "?quantity", "result": "?subtotal_cents" }
              },
              {
                "predicate": "add",
                "args": { "left": "?subtotal_cents", "right": "?shipping_cents", "result": "?total_cents" }
              }
            ],
            "then": [
              {
                "predicate": "calculation_result",
                "args": {
                  "node": "?node",
                  "job_id": "?job_id",
                  "subtotal_cents": "?subtotal_cents",
                  "total_cents": "?total_cents"
                }
              }
            ]
          }
        ],
        "empirical": [],
        "theorems": [],
        "acceptance": [
          {
            "id": "accept_read_back_output",
            "description": "The leaf is accepted only when the worker read back the same job and exact totals that the board derived.",
            "when": [
              { "predicate": "acceptance", "args": { "node": "?node", "test": "?test" } },
              {
                "predicate": "calculation_result",
                "args": {
                  "node": "?node",
                  "job_id": "?test",
                  "subtotal_cents": "?subtotal_cents",
                  "total_cents": "?total_cents"
                }
              },
              {
                "predicate": "output_written",
                "args": {
                  "node": "?node",
                  "job_id": "?test",
                  "subtotal_cents": "?subtotal_cents",
                  "total_cents": "?total_cents",
                  "status": "completed"
                }
              },
              {
                "predicate": "output_record",
                "args": {
                  "node": "?node",
                  "job_id": "?test",
                  "subtotal_cents": "?subtotal_cents",
                  "total_cents": "?total_cents",
                  "status": "completed"
                }
              }
            ],
            "then": [{ "predicate": "acceptance_met", "args": { "node": "?node" } }]
          }
        ]
      }
    },
    {
      "packType": "tools",
      "pack": {
        "format": "rulith-tools/1",
        "meta": { "name": "verified_calculation_io", "version": 1 },
        "tools": [
          {
            "name": "load_calculation_input",
            "kind": "read",
            "impl": "run",
            "source": "verified-calculation-local",
            "desc": "[intake] Read and validate the configured local input.json, then create the task. Pass no target and no business arguments.",
            "params": {},
            "returns": [
              {
                "predicate": "calculation_input",
                "args": {
                  "node": "$node",
                  "job_id": "$job_id",
                  "unit_price_cents": "$unit_price_cents",
                  "quantity": "$quantity",
                  "shipping_cents": "$shipping_cents"
                }
              },
              {
                "predicate": "task_seed",
                "args": { "root": "$task_root", "node": "$node", "test": "$acceptance_test" }
              }
            ]
          },
          {
            "name": "write_calculation_result",
            "kind": "write",
            "impl": "run",
            "source": "verified-calculation-local",
            "desc": "Write only the exact result bound from trusted input plus the board-derived calculation. Pass no business arguments; add only the target leaf.",
            "params": {
              "node": "string",
              "job_id": "string",
              "unit_price_cents": "number",
              "quantity": "number",
              "shipping_cents": "number",
              "subtotal_cents": "number",
              "total_cents": "number"
            },
            "preconditions": [
              {
                "predicate": "calculation_input",
                "args": {
                  "node": "?node",
                  "job_id": "?job_id",
                  "unit_price_cents": "?unit_price_cents",
                  "quantity": "?quantity",
                  "shipping_cents": "?shipping_cents"
                }
              },
              {
                "predicate": "calculation_result",
                "args": {
                  "node": "?node",
                  "job_id": "?job_id",
                  "subtotal_cents": "?subtotal_cents",
                  "total_cents": "?total_cents"
                }
              }
            ],
            "effects": [
              {
                "predicate": "output_written",
                "args": {
                  "node": "?node",
                  "job_id": "?job_id",
                  "subtotal_cents": "?subtotal_cents",
                  "total_cents": "?total_cents",
                  "status": "completed"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "packType": "channels",
      "pack": {
        "format": "rulith-channels/1",
        "meta": { "name": "verified_calculation_local_worker", "version": 1 },
        "channels": [
          {
            "id": "__RULITH_CHANNEL__",
            "role": "compute",
            "recertifiable": false,
            "tools": ["load_calculation_input", "write_calculation_result"]
          }
        ],
        "bindings": [
          { "predicate": "calculation_input", "channel": "__RULITH_CHANNEL__", "tier": "attested" },
          { "predicate": "task_seed", "channel": "__RULITH_CHANNEL__", "tier": "attested" },
          { "predicate": "output_record", "channel": "__RULITH_CHANNEL__", "tier": "attested" }
        ]
      }
    }
  ]
}
