{
  "collection": {
    "id": "verified_calculation",
    "version": "1.0.0",
    "title": "Verified Calculation",
    "summary": "Read trusted local JSON, derive an exact total, write the result, and verify it by independent read-back."
  },
  "packs": [
    {
      "packType": "domain",
      "pack": {
        "format": "rulith-pack/1",
        "meta": {
          "name": "verified_calculation",
          "title": "Verified Calculation — Knowledge",
          "version": 1,
          "deps": [],
          "provides": ["calculation_result"]
        },
        "pins": ["calculation_result"],
        "vocab": [
          {
            "predicate": "calculation_input",
            "args": ["node", "job_id", "unit_price_cents", "quantity", "shipping_cents"],
            "description": "A validated input record read by the trusted local source adapter; the model cannot assert this predicate."
          },
          {
            "predicate": "calculation_result",
            "args": ["node", "job_id", "subtotal_cents", "total_cents"],
            "description": "Exact subtotal and total derived by the board closure, never supplied by the model or source adapter."
          },
          {
            "predicate": "output_written",
            "args": ["node", "job_id", "subtotal_cents", "total_cents", "status"],
            "description": "Synchronous action effect applied only after the trusted writer atomically wrote and read back the output file."
          },
          {
            "predicate": "output_record",
            "args": ["node", "job_id", "subtotal_cents", "total_cents", "status"],
            "description": "Independent read-only verification of the persisted output, attested through the configured worker channel."
          },
          {
            "predicate": "task_seed",
            "args": ["root", "node", "test"],
            "description": "Trusted intake result used by the host to create the one-leaf task tree."
          }
        ],
        "axioms": [
          {
            "id": "calculate_total",
            "description": "subtotal = unit price × quantity; total = subtotal + shipping, using exact-or-fail board arithmetic.",
            "tier": "verified",
            "source": "integer-arithmetic",
            "when": [
              {
                "predicate": "calculation_input",
                "args": {
                  "node": "?node",
                  "job_id": "?job_id",
                  "unit_price_cents": "?unit_price_cents",
                  "quantity": "?quantity",
                  "shipping_cents": "?shipping_cents"
                }
              },
              {
                "predicate": "mul",
                "args": { "left": "?unit_price_cents", "right": "?quantity", "result": "?subtotal_cents" }
              },
              {
                "predicate": "add",
                "args": { "left": "?subtotal_cents", "right": "?shipping_cents", "result": "?total_cents" }
              }
            ],
            "then": [
              {
                "predicate": "calculation_result",
                "args": {
                  "node": "?node",
                  "job_id": "?job_id",
                  "subtotal_cents": "?subtotal_cents",
                  "total_cents": "?total_cents"
                }
              }
            ]
          }
        ],
        "empirical": [],
        "theorems": [],
        "acceptance": [
          {
            "id": "accept_read_back_output",
            "description": "The leaf is accepted only when the worker read back the same job and exact totals that the board derived.",
            "when": [
              { "predicate": "acceptance", "args": { "node": "?node", "test": "?test" } },
              {
                "predicate": "calculation_result",
                "args": {
                  "node": "?node",
                  "job_id": "?test",
                  "subtotal_cents": "?subtotal_cents",
                  "total_cents": "?total_cents"
                }
              },
              {
                "predicate": "output_written",
                "args": {
                  "node": "?node",
                  "job_id": "?test",
                  "subtotal_cents": "?subtotal_cents",
                  "total_cents": "?total_cents",
                  "status": "completed"
                }
              },
              {
                "predicate": "output_record",
                "args": {
                  "node": "?node",
                  "job_id": "?test",
                  "subtotal_cents": "?subtotal_cents",
                  "total_cents": "?total_cents",
                  "status": "completed"
                }
              }
            ],
            "then": [{ "predicate": "acceptance_met", "args": { "node": "?node" } }]
          }
        ],
        "actions": [
          {
            "action": "load_calculation_input",
            "description": "[intake] Read and validate the configured local input.json, then create the task. Pass no target and no business arguments.",
            "preconditions": [],
            "effects": [],
            "execution": {
              "tool": "rulith.verified_calculation.read_input@1",
              "source": "verified-calculation-local",
              "kind": "read",
              "params": {},
              "returns": [
                {
                  "predicate": "calculation_input",
                  "args": {
                    "node": "$node",
                    "job_id": "$job_id",
                    "unit_price_cents": "$unit_price_cents",
                    "quantity": "$quantity",
                    "shipping_cents": "$shipping_cents"
                  }
                },
                {
                  "predicate": "task_seed",
                  "args": { "root": "$task_root", "node": "$node", "test": "$acceptance_test" }
                }
              ]
            }
          },
          {
            "action": "write_calculation_result",
            "description": "After intake, calculation_result is derived automatically from trusted input. Do not assert or calculate it yourself; invoke this action directly. Pass no business arguments and add only the target leaf.",
            "preconditions": [
              {
                "predicate": "calculation_input",
                "args": {
                  "node": "?node",
                  "job_id": "?job_id",
                  "unit_price_cents": "?unit_price_cents",
                  "quantity": "?quantity",
                  "shipping_cents": "?shipping_cents"
                }
              },
              {
                "predicate": "calculation_result",
                "args": {
                  "node": "?node",
                  "job_id": "?job_id",
                  "subtotal_cents": "?subtotal_cents",
                  "total_cents": "?total_cents"
                }
              }
            ],
            "effects": [
              {
                "predicate": "output_written",
                "args": {
                  "node": "?node",
                  "job_id": "?job_id",
                  "subtotal_cents": "?subtotal_cents",
                  "total_cents": "?total_cents",
                  "status": "completed"
                }
              }
            ],
            "execution": {
              "tool": "rulith.verified_calculation.write_output@1",
              "source": "verified-calculation-local",
              "kind": "write",
              "params": {
                "node": "string",
                "job_id": "string",
                "unit_price_cents": "number",
                "quantity": "number",
                "shipping_cents": "number",
                "subtotal_cents": "number",
                "total_cents": "number"
              }
            }
          },
          {
            "action": "verify_calculation_output",
            "description": "Read the persisted output and attest only an exact match to the board-bound result.",
            "preconditions": [
              { "predicate": "calculation_result", "args": { "node": "?node", "job_id": "?job_id", "subtotal_cents": "?subtotal_cents", "total_cents": "?total_cents" } },
              { "predicate": "output_written", "args": { "node": "?node", "job_id": "?job_id", "subtotal_cents": "?subtotal_cents", "total_cents": "?total_cents", "status": "?status" } }
            ],
            "effects": [],
            "execution": {
              "tool": "rulith.verified_calculation.verify_output@1",
              "source": "verified-calculation-local",
              "kind": "read",
              "params": {
                "node": "string",
                "job_id": "string",
                "subtotal_cents": "number",
                "total_cents": "number",
                "status": "string"
              },
              "returns": [
                { "predicate": "output_record", "args": { "node": "$node", "job_id": "$job_id", "subtotal_cents": "$subtotal_cents", "total_cents": "$total_cents", "status": "$status" } }
              ]
            }
          }
        ]
      }
    },
    {
      "packType": "sources",
      "pack": {
        "format": "rulith-sources/1",
        "meta": { "name": "verified_calculation_source", "version": 1 },
        "title": "Verified Calculation — Local source",
        "sources": [
          {
            "name": "verified-calculation-local",
            "type": "file",
            "access": "runtime",
            "words": ["calculation_input", "task_seed", "output_record"],
            "tier": "attested",
            "territoryHint": "Customer-controlled local JSON files"
          }
        ]
      }
    }
  ]
}
