{
  "roles": ["agent", "worker"],
  "agent": {
    "args": ["--agent", "default"],
    "env": {
      "RULITH_URL": "https://api.rulith.ai",
      "RULITH_TOKEN": "",
      "RULITH_MODEL_URL": "",
      "RULITH_MODEL": "",
      "RULITH_MODEL_KEY": ""
    }
  },
  "worker": {
    "env": {
      "RULITH_WORK_URL": "https://api.rulith.ai/work",
      "RULITH_CONNECTION": "",
      "RULITH_CONNECTION_KEY": ""
    }
  },
  "paths": {
    "agent": "../agent/rulith-agent.mjs",
    "worker": "../worker/rulith-worker.mjs"
  }
}
