  "axioms": [
    {
      "id": "ENG_CHECK_PASSED",
      "description": "A passing named check remains current until a tree step leaves its generation.",
      "source": "engineering_work",
      "tier": "verified",
      "when": [
        {
          "predicate": "eng.test_result",
          "args": {
            "check": "?c",
            "spec_digest": "?d",
            "gen": "?g",
            "exit_code": 0
          }
        },
        {
          "predicate": "eng.tree_step",
          "args": {
            "from_gen": "?g",
            "to_gen": "?n"
          },
          "naf": true
        }
      ],
      "then": [
        {
          "predicate": "eng.check_passed",
          "args": {
            "check": "?c",
            "spec_digest": "?d"
          }
        }
      ]
    }
  ],
  "acceptance": [
    {
      "id": "ENG_CHECK_ACCEPTANCE",
      "description": "The signed leaf names the check; its desired atom fixes the spec digest.",
      "when": [
        {
          "predicate": "acceptance",
          "args": {
            "node": "?n",
            "test": "?c"
          }
        },
        {
          "predicate": "eng.check_passed",
          "args": {
            "check": "?c",
            "spec_digest": "?d"
          }
        }
      ],
      "then": [
        {
          "predicate": "acceptance_met",
          "args": {
            "node": "?n"
          }
        }
      ]
    }
